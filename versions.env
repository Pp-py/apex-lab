# ---------------------------------------------------------------------------
# versions.env - Única fuente de verdad de versiones del entorno.
#
# Cambiar SOLO acá y volver a correr ./build.sh. Nunca usar tags móviles
# (`latest`, `23`) en un build reproducible: hoy resuelven a una cosa y en
# tres meses a otra, sin que el repo cambie.
#
# Los valores que compose también necesita (ORDS_TAG, la contraseña, el tag de
# la imagen y las convenciones del perfil) los propaga ./build.sh al .env y los
# valida en cada corrida. No los copies a mano: el build aborta si divergen.
# ---------------------------------------------------------------------------

# --- Base de datos ---------------------------------------------------------
# Perfil de convenciones de la imagen base: 'gvenzl' | 'oracle'.
# Cada imagen usa nombres distintos para la variable de contraseña, el
# healthcheck y el directorio de scripts de init. Las diferencias están
# aisladas en scripts/base-profile.sh; migrar es cambiar esta línea y
# DB_BASE_IMAGE, nada más.
DB_IMAGE_PROFILE="gvenzl"

# Imagen base. Usar SIEMPRE el tag de 3 dígitos + '-full-faststart'.
#   -full      : conserva todos los componentes de la BD (JVM, Oracle Text...).
#                '-slim' los recorta y rompe funcionalidades de APEX.
#   -faststart : la BD ya viene creada dentro de la imagen. Es el punto de
#                partida necesario para hornear APEX encima.
# Estado de tags: https://github.com/gvenzl/oci-oracle-free#supported-tags
DB_BASE_IMAGE="gvenzl/oracle-free:23.26.2-full-faststart"

# Plan B — imagen oficial de Oracle. Descomentar junto con DB_IMAGE_PROFILE="oracle".
# El tag debe ser 'full', no 'lite' (lite recorta componentes de la base).
# DB_BASE_IMAGE="container-registry.oracle.com/database/free:latest"

# --- Oracle APEX -----------------------------------------------------------
# Versión exacta a instalar. NO usar apex-latest.zip en el build (irreproducible).
APEX_VERSION="26.1"
APEX_URL="https://download.oracle.com/otn_software/apex/apex_${APEX_VERSION}.zip"

# SHA256 del zip. Dejar vacío en el primer build: build.sh lo calcula y lo
# imprime para que lo pegues acá. A partir de ahí el build valida integridad.
APEX_SHA256="06df14e7c8465747ee45c36c5a0b09821bf2b244db0e201d3cc44abb0403f023"

# --- ORDS ------------------------------------------------------------------
# Contenedor oficial de Oracle. APEX 26.1 exige ORDS >= 26.1.1.
# No se hornea: se actualiza cambiando este tag, sin rebuild de la BD.
ORDS_TAG="26.1.2"

# --- Imagen resultante -----------------------------------------------------
# Tag inmutable (el que referencian los proyectos) + tag móvil de conveniencia.
IMAGE_NAME="apex-lab"
IMAGE_TAG="db23.26.2-apex${APEX_VERSION}"
IMAGE_TAG_MOVING="latest"

# --- Credenciales de build -------------------------------------------------
# Quedan HORNEADAS en la imagen. Es un entorno local de prototipado: no poner
# acá nada que uses en otro lado. Ver README, sección "Credenciales".
#
# Estas contraseñas viajan a los .sql por sustitución de SQL*Plus, así que
# build.sh rechaza '&', comillas, backslash, '$' y espacios: partirían el valor
# en dos y la imagen quedaría con una contraseña distinta de la documentada.
#
# Son DEFAULTS sobreescribibles desde el entorno, sin editar (ni ensuciar) este
# archivo:
#
#     BUILD_APEX_ADMIN_PASSWORD='Otra_Clave_2026#' ./build.sh
#
# Útil para no versionar una contraseña que no querés compartir. Ojo: el valor
# queda igual horneado en la imagen, y como ORACLE_PASSWORD se deriva de
# BUILD_ORACLE_PASSWORD, un .env preexistente va a divergir — build.sh te lo
# dice y te señala la línea.
BUILD_ORACLE_PASSWORD="${BUILD_ORACLE_PASSWORD:-oracle}"
BUILD_APEX_ADMIN_PASSWORD="${BUILD_APEX_ADMIN_PASSWORD:-Apex_Lab_2026#}"
BUILD_APEX_ADMIN_EMAIL="${BUILD_APEX_ADMIN_EMAIL:-admin@apex.local}"
